{
  "name": "dsh-cloud-sync",
  "version": "0.4.0",
  "description": "OpenTelemetry GenAI observability (reusing LoongSuite plugin) + multi-device cloud state sync for DeepSeek Harness",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "dependencies": {
    "@loongsuite/dsh-plugin": "^0.1.3"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "opentelemetry",
    "genai",
    "observability",
    "cloud-sync",
    "multi-device"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robinliang0829-lgtm/dsh-cloud-sync.git"
  },
  "homepage": "https://github.com/robinliang0829-lgtm/dsh-cloud-sync#readme",
  "bugs": {
    "url": "https://github.com/robinliang0829-lgtm/dsh-cloud-sync/issues"
  },
  "author": "robinliang0829-lgtm"
}
